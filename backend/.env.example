APP_NAME="CEP Clientes API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8081
APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=cep_clientes
DB_USERNAME=cep_user
DB_PASSWORD=cep_password

CACHE_STORE=database
CACHE_PREFIX=cep_clientes_cache

# Provider principal da aplicação.
# Opções suportadas: viacep, correios, fake.
# Para execução local simples, use viacep.
# Para integração oficial dos Correios, use correios após liberar a API CEP no contrato.
CEP_PROVIDER=viacep

# Provider de fallback opcional.
# Deixe vazio para desativar fallback.
CEP_FALLBACK_PROVIDER=correios

# ViaCEP
VIACEP_BASE_URL=https://viacep.com.br/ws
VIACEP_TIMEOUT=10

# API oficial dos Correios
CORREIOS_BASE_URL=https://api.correios.com.br
CORREIOS_TOKEN_BASE_URL=https://api.correios.com.br
CORREIOS_CEP_ENDPOINT=/cep/v2/enderecos/{cep}
CORREIOS_TIMEOUT=15
CORREIOS_RETRY_TIMES=2
CORREIOS_RETRY_SLEEP_MS=300

# Opção 1: token/chave já gerado/subdelegado.
# Se preencher este campo, a aplicação usa este Bearer Token diretamente.
CORREIOS_BEARER_TOKEN=

# Opção 2: geração automática de token pela API Token dos Correios.
# Para Busca CEP, o manual recomenda autorização por contrato.
CORREIOS_AUTH_TYPE=contrato
CORREIOS_USERNAME=
CORREIOS_PASSWORD=
CORREIOS_CONTRACT_NUMBER=
CORREIOS_CONTRACT_DR=
CORREIOS_POSTING_CARD_NUMBER=
CORREIOS_TOKEN_CACHE_MARGIN_SECONDS=300
CORREIOS_TOKEN_DEFAULT_TTL_SECONDS=3300

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173